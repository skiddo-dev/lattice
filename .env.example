# Lattice configuration — every key is OPTIONAL.
# Lattice boots with nothing set and tells you what to configure in the UI.
# Copy to `.env` and fill in what you have.

# --- Local backend (Ollama / LM Studio — both expose an OpenAI-compatible API) ---
# Point at the /v1 base. Over Tailscale this is your rig's tailnet host.
#   Ollama:    http://localhost:11434/v1   (or http://<rig>.tailnet.ts.net:11434/v1)
#   LM Studio: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key; LM Studio too. Left as a placeholder for OpenAI-compat servers that want one.
LOCAL_LLM_API_KEY=ollama
# Optional: force a default local model (otherwise the first installed model is used).
# LOCAL_LLM_MODEL=llama3.1:8b

# Native Ollama base for runtime telemetry (/api/ps, /api/tags). Defaults to
# LOCAL_LLM_BASE_URL with the trailing /v1 stripped, so you usually don't set this.
# OLLAMA_URL=http://localhost:11434

# --- Cloud fallback (OpenAI) ---
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- GPU telemetry (optional) ---
# A small exporter on the rig that returns JSON GPU stats. If unset, Lattice
# falls back to local `nvidia-smi` when it runs on the rig, else shows "not configured".
# GPU_EXPORTER_URL=http://<rig>.tailnet.ts.net:9835/gpu

# --- Agents (scheduled jobs) ---
# Where agent definitions + run history persist (a single JSON file).
# DATA_DIR=./data

# --- Server ---
PORT=8770
